let mapleader=" "

""" Plugins  --------------------------------
set surround
set multiple-cursors
set commentary
set argtextobj
set easymotion
set textobj-entire
set ReplaceWithRegister
set exchange

Plug 'preservim/nerdtree'
Plug 'machakann/vim-highlightedyank'
Plug 'terryma/vim-multiple-cursors'

""" Plugin settings -------------------------
let g:argtextobj_pairs="[:],(:),<:>"

""" Common settings -------------------------
set showmode
set so=5
set nu
set incsearch
set hlsearch

""" Idea specific settings ------------------
set ideajoin
set ideastatusicon=gray
set visualbell

""" My Mappings -----------------------------

" ======================
" Search
" ======================
map <leader>ff <Action>(GotoFile)
map <leader>fg <Action>(FindInPath)

" ======================
" Code
" ======================
map <leader>gd <Action>(GotoDeclaration)
map <leader>gi <Action>(GotoImplementation)
map <leader>gt <Action>(GotoTypeDeclaration)
map <leader>iv <Action>(IntroduceVariable)
map <leader>ip <Action>(IntroduceParameter)
map <leader>in <Action>(Inline)
map <leader>em <Action>(ExtractMethod)

" ======================
" Debug
" ======================
map <leader>ee <Action>(EvaluateExpression)

" ======================
" Refactoring
" ======================
map <leader>rn <Action>(RenameElement)
map <leader>cs <Action>(ChangeSignature)

" ======================
" Git
" ======================
map <leader>gf <Action>(Vcs.ShowTabbedFileHistory)
map <leader>gcwb <Action>(Git.CompareWithBranch)
map <leader>gb <Action>(Git.Branches)

" ======================
" Windows
" ======================
map <leader>sv <Action>(SplitVertically)
map <leader>sh <Action>(SplitHorizontally)
map <leader>bd <Action>(CloseContent)
map <leader>b  <Action>(SelectInProjectView)

" ======================
" Terminal
" ======================
map <leader>tt <Action>(ActivateTerminalToolWindow)

" ======================
" Others
" ======================
map <leader>s <Action>(SaveAll)
map <leader>p <Action>(PasteMultiple)
map <S-Space> <Action>(GotoNextError)
map <leader>ww <C-w>w
map <leader>a ggVG
nnoremap <leader>fe :NERDTreeToggle<CR>
map <C-e> :action RecentFiles<CR>

vnoremap y "+y`>
nnoremap Y "+yg_
nnoremap yy "+yy

vnoremap p pgvy

nnoremap <C-s> :w<CR>
vnoremap <C-s> <Esc>:w<CR>
inoremap <C-s> <C-o>:w<CR><Esc>

vnoremap < <gv
vnoremap > >gv

nnoremap <CR> :noh<CR>

nmap <C-n> <Plug>NextWholeOccurrence
xmap <C-n> <Plug>NextWholeOccurrence
nmap g<C-n> <Plug>NextOccurrence
xmap g<C-n> <Plug>NextOccurrence
xmap <C-x> <Plug>SkipOccurrence
xmap <C-p> <Plug>RemoveOccurrence
